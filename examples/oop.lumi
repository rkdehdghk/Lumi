// 객체지향 (OOP) — 클래스·객체·상속·다형성·캡슐화·연산자 재정의
// 클래스는 '설계도', 객체는 그 설계도로 찍어 낸 '실제 하나'입니다.

// --- 생성자와 메서드가 있는 첫 클래스 ---
print("--- a first class ---")

class Animal:
    val kingdom = "animalia"       // 공유 값 — 이 클래스로 만든 모두가 같이 봅니다

    func init(name):               // init 은 객체를 만들 때 저절로 불립니다 (생성자)
        this.name = name           // this 는 지금 만들어지는 그 객체

    func speak():
        print(this.name + " makes a sound")

    func text():                   // print(객체) 가 어떻게 보일지 정합니다
        return "Animal(" + this.name + ")"

val a = Animal("Nabi")             // 클래스를 함수처럼 부르면 객체가 만들어집니다 (new 없음)
a.speak()                          // Nabi makes a sound
print(a)                           // Animal(Nabi)
print(a.name, a.kingdom)           // Nabi animalia
print(type(a))                     // Animal   객체의 자료형은 곧 클래스 이름

// --- 상속 : from 으로 부모의 것을 그대로 물려받습니다 ---
print("--- inheritance ---")

class Dog from Animal:
    func init(name, age):
        super.init(name)           // 부모의 init 을 불러 name 부터 맡깁니다
        this.age = age

    func speak():                  // 재정의 — 부모의 speak 를 대신합니다
        super.speak()              // ...그래도 super 로 부모 것을 부를 수 있습니다
        print(this.name + " barks")

    func text():
        return "Dog(" + this.name + ", " + str(this.age) + ")"

val d = Dog("Bori", 3)
d.speak()
print(d)                           // Dog(Bori, 3)
print(d.kingdom)                   // animalia   물려받은 공유 값
print(isa(d, Dog), isa(d, Animal)) // true true  Dog 는 Animal 이기도 합니다

// --- 필드는 보통 변수처럼 고칠 수 있습니다 ---
print("--- fields ---")
d.age = 5
d.age += 1
d.age++
print(d.age)                       // 7

// --- 다형성 : 같은 이름으로 불러도 종류마다 다르게 움직입니다 ---
print("--- polymorphism ---")
for x in [Animal("Nabi"), Dog("Bori", 3)]:
    x.speak()

// --- 캡슐화 : 이름이 _ 로 시작하면 비공개입니다 ---
print("--- encapsulation ---")

class Counter:
    int _count = 0                 // 비공개이면서, 정수만 담기게 검사까지 받습니다

    func init():
        this._count = 0

    func step():
        this._count++
        return this._count

    func value():
        return this._count         // 바깥에서 값을 볼 수 있는 유일한 통로

    func equals(other):            // 이 클래스에서 == 이 무슨 뜻인지 정합니다
        return isa(other, Counter) and this._count == other._count

val c = Counter()
c.step()
c.step()
print(c.value())                   // 2
// print(c._count)                 // <- 오류: _count 는 비공개라 밖에서 못 봅니다

val c2 = Counter()
c2.step()
c2.step()
print(c == c2)                     // true   equals() 가 그렇게 정했습니다
print(c == Counter())              // false

// --- 공유 값은 클래스 쪽에 있습니다 ---
print("--- class values ---")
print(Animal.kingdom, Dog.kingdom) // animalia animalia
Dog.kingdom = "canis"              // 자식이 고치면 자식만의 몫이 생깁니다
print(Animal.kingdom, Dog.kingdom) // animalia canis

// --- 추상 메서드 : 자식이 반드시 만들어야 하는 빈 틀 ---
print("--- abstract methods ---")

class Shape:
    abstract func area()           // 몸통 없이 이름만 — Shape() 로는 객체를 못 만듭니다

class Circle from Shape:
    func init(r):
        this.r = r
    func area():                   // 자식이 채워 넣습니다
        return 3.14 * this.r * this.r

val circle = Circle(5)
print("Circle area:", circle.area())  // 78.5

// --- 연산자 재정의 : +, -, *, /, %, <, >, [], []= ---
// 특별한 이름의 메서드를 만들면 그 연산자가 이 클래스에서 어떻게 움직일지 정해집니다.
print("--- operator overloading ---")

class Vector:
    func init(x, y):
        this.x = x
        this.y = y

    func add(other):               // v1 + v2
        return Vector(this.x + other.x, this.y + other.y)

    func sub(other):               // v1 - v2
        return Vector(this.x - other.x, this.y - other.y)

    func mul(n):                   // v1 * 3
        return Vector(this.x * n, this.y * n)

    func text():                   // print(v1)
        return "Vector(" + str(this.x) + ", " + str(this.y) + ")"

    func get(idx):                 // v1[0]
        if idx == 0:
            return this.x
        if idx == 1:
            return this.y
        return                     // 그 밖의 자리는 돌려줄 값 없이 끝냅니다 (none)

    func set(idx, value):          // v1[0] = 10
        if idx == 0:
            this.x = value
        if idx == 1:
            this.y = value

val v1 = Vector(2, 4)
val v2 = Vector(1, 3)

print("v1 + v2 =", v1 + v2)         // Vector(3, 7)
print("v1 - v2 =", v1 - v2)         // Vector(1, 1)
print("v1 * 3 =", v1 * 3)           // Vector(6, 12)
print("v1[0] =", v1[0], "v1[1] =", v1[1])  // 2 4

v1[0] = 10
print("After v1[0] = 10:", v1)       // Vector(10, 4)
