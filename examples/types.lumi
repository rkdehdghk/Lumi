// 골라 쓰는 자료형 - 적고 싶은 곳에만 적습니다
//
//   func 이름(자료형 인자, ...) 돌려주는자료형:
//
// 안 적으면 지금까지와 똑같습니다. 적으면 부를 때와 돌려줄 때 검사받습니다.
// 검사 규칙은 'int x = 5' 선언과 똑같습니다 - 같은 코드를 씁니다.

print("=== 1. 안 적어도 됩니다 ===")

func twice(x):
    return x * 2

print(twice(21))
print(twice("가"))          // 글자도 됩니다 - 아무 것도 안 적었으니까요

print("")
print("=== 2. 적으면 지켜집니다 ===")

func say_age(str name, int age) str:
    return name + "은(는) " + str(age) + "살"

print(say_age("루미", 3))

// (숫자를 변수에 담아 넘깁니다 - 그 자리에 그대로 3 이라고 적으면
//  lumi lint 가 돌리기 전에 잡아 주고, 이 파일은 lint 가 깨끗해야 합니다)
val n = 3
try:
    print(say_age(n, 3))
catch e:
    print("막혔습니다: " + e.message)

print("")
print("=== 3. 돌려주는 값도 봅니다 ===")

func half(num n) int:
    return n / 2

print(half(10))            // 5.0 이 int 로 다듬어져 5

func lie() str:
    return n                // 글자를 돌려준다고 적어 놓고 숫자를 돌려줍니다

try:
    print(lie())
catch e:
    print("막혔습니다: " + e.message)

print("")
print("=== 4. 쓸 수 있는 이름 ===")

// 값을 다듬어 주는 것:  int  float  num  char  str  text  seq  bytes
// 보기만 하는 것:       bool list  tuple dict
// 넷은 선언에도 함께 쓸 수 있습니다.

func first_of(list items) num:
    return items[0]

func how_many(dict d) int:
    return len(keys(d))

bool on = true
tuple point = (3, 4)

print(first_of([10, 20, 30]))
print(how_many({"가": 1, "나": 2}))
print(on)
print(point)

print("")
print("=== 5. 클래스 메서드에도 ===")

class PiggyBank:
    func init(int opening):
        this.money = opening
    func deposit(int amount) int:
        this.money = this.money + amount
        return this.money

val jar = PiggyBank(1000)
print(jar.deposit(500))

try:
    print(jar.deposit([1000]))
catch e:
    print("막혔습니다: " + e.message)

// 주의: int 는 **글자를 코드로 바꿉니다** ('int x = "A"' 가 65 인 것과 같습니다).
// 그래서 jar.deposit("천원") 은 막히지 않고 첫 글자의 코드가 들어갑니다.

print("")
print("=== 6. 돌리기 전에 - lumi lint ===")
print("글자로 그 자리에 적어 둔 값이 어긋나면 lumi lint 가 돌리기 전에 알려 줍니다.")
print("  func 나이말하기(str 이름, int 살) str:  를")
print("  나이말하기(3, 3)  으로 부르면 lint 가 그 줄을 짚어 줍니다.")
