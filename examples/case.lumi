// Case conversion & whitespace removal (대소문자·공백) in Lumi
//
// 세 함수 모두 '어디를' 손볼지 먼저, '문자열'을 마지막에 적습니다.
//   upper([어디,] 문자열)  ->  대문자로 바꾼 새 문자열
//   lower([어디,] 문자열)  ->  소문자로 바꾼 새 문자열
//   strip([어디,] 문자열)  ->  공백을 지운 새 문자열
//
// '어디를' 은 네 가지로 적을 수 있습니다.
//   안 적음        전체
//   자리 번호      그 한 글자만        (0부터 셉니다. 음수면 뒤에서부터)
//   시작:끝        그 구간만          (슬라이싱과 같은 방식)
//   [자리, 자리]   적어 준 자리들만    (튜플도 됩니다)

print("=== 전체 바꾸기 (어디를 안 적으면 전부) ===")
val phrase = "hello world"
print(phrase)
print(upper(phrase))                  // HELLO WORLD
print(lower("LUMI Language"))     // lumi language

print("")
print("=== 한 글자만 바꾸기 ===")
print(upper(0, phrase))               // Hello world
print(upper(6, phrase))               // hello World
print(upper(-1, phrase))              // hello worlD   음수는 뒤에서부터
print(lower(0, "HELLO"))          // hELLO

print("")
print("=== 구간으로 바꾸기 (슬라이싱과 같은 방식) ===")
print(upper(0:5, phrase))             // HELLO world   0 이상 5 미만
print(upper(:5, phrase))              // HELLO world   시작 생략 = 처음부터
print(upper(6:, phrase))              // hello WORLD   끝 생략 = 마지막까지
print(upper(:, phrase))               // HELLO WORLD   둘 다 생략 = 전체
print(upper(3:3, phrase))             // hello world   빈 구간이라 그대로

// 시작과 끝에 변수나 식을 넣어도 됩니다.
val begin = 2
val end = 5
print(upper(begin:end, phrase))          // heLLO world
print(upper(begin:len(phrase), phrase))     // heLLO WORLD

print("")
print("=== 자리 리스트로 바꾸기 (떨어져 있는 자리들) ===")
print(upper([0, 6], phrase))          // Hello World
print(upper([0, 2, 4], "abcdef")) // AbCdEf
print(upper((0, 1), "abc"))       // ABc           튜플도 됩니다
print(upper([], "abc"))           // abc           빈 리스트면 그대로

print("")
print("=== 원래 문자열은 그대로 있어요 ===")
// 바뀐 '새 문자열'을 돌려주기 때문에, 남기려면 다시 넣어 줍니다.
print(phrase)                         // hello world   그대로
val loud = upper(phrase)
print(loud)                       // HELLO WORLD

print("")
print("=== 대소문자가 없는 글자는 그대로 지나가요 ===")
print(upper("lumi 2026!"))        // LUMI 2026!
print(upper("루미 lumi"))          // 루미 LUMI

print("")
print("=== 이름처럼 첫 글자만 대문자로 ===")
func titlecase(word):
    return upper(0, lower(word))

print(titlecase("hONG"))              // Hong
print(titlecase("lumi"))              // Lumi

print("")
print("=== 찾은 자리만 바꾸기 (infind 와 함께) ===")
// infind 가 돌려준 자리 리스트를 그대로 넘기면 찾은 곳만 바뀝니다.
print(infind("o", phrase))            // [4, 7]
print(upper(infind("o", phrase), phrase))  // hellO wOrld

print("")
print("=== 단어마다 첫 글자를 대문자로 ===")
val firstpos = [0]
for pos in infind(" ", phrase):
    push(firstpos, pos + 1)
print(firstpos)                      // [0, 6]
print(upper(firstpos, phrase))           // Hello World

print("")
print("=== 검사하고 나서 바꾸기 ===")
val userid = "Lumi2026"
if isalgit(userid):
    print("쓸 수 있는 아이디:", lower(userid))   // lumi2026
else:
    print("영어와 숫자만 적어 주세요")

print("")
print("=== 공백 지우기 (strip) - 적는 법은 위와 똑같아요 ===")
// 자리:  0=a  1=공백  2=b  3=공백  4=c  5=공백  6=d
val spaced = "a b c d"
print(spaced)
print(strip(spaced))                 // abcd      전체의 공백
print(strip("  안녕   하세요  "))   // 안녕하세요

print("")
print("=== 자리 / 구간 / 리스트로 골라 지우기 ===")
print(strip(1, spaced))              // ab c d    1번 자리가 공백이라 지워짐
print(strip(0, spaced))              // a b c d   0번은 'a' 라서 그대로 (글자는 안 지워요)
print(strip(0:3, spaced))            // ab c d    0~2 사이의 공백만
print(strip(3:, spaced))             // a bcd     3번부터 끝까지
print(strip(:, spaced))              // abcd      전체와 같음
print(strip([1, 5], spaced))         // ab cd     적어 준 자리들만
print(strip([], spaced))             // a b c d   빈 리스트면 그대로

print("")
print("=== 자리 번호는 '지우기 전' 문자열 기준이에요 ===")
// 앞의 공백을 지워서 길이가 줄어도, 뒤에 적은 번호가 밀리지 않습니다.
print(strip([1, 3, 5], spaced))      // abcd
print(spaced)                        // a b c d   원본은 그대로

print("")
print("=== 탭과 줄바꿈도 공백이에요 ===")
print(strip("탭\t줄\n끝"))          // 탭줄끝

print("")
print("=== 입력에 섞인 공백 털어내기 ===")
val answer = " 42 "                    // input() 으로 받았다고 생각해 보세요
print(num(strip(answer)) + 1)          // 43

print("")
print("=== 앞뒤만 털고 가운데 띄어쓰기는 남기기 ===")
val padded = "  안녕 하세요  "
print(strip(0:2, strip(-2:, padded)))  // 안녕 하세요

print("")
print("=== 공백 자리를 찾아서 하나만 지우기 ===")
print(infind(" ", spaced))                 // [1, 3, 5]
print(strip(infind(" ", spaced)[0], spaced))  // ab c d   맨 앞 공백 하나만

print("")
print("=== 셋을 함께 쓰기 ===")
val word = "  hong GIL dong  "
print(upper(0, lower(strip(word))))      // Honggildong
