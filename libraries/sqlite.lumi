// sqlite -- 파일 하나짜리 데이터베이스
//
//   bring sqlite
//   val db = sqlite.open("가게.db")
//   sqlite.run("create table if not exists 손님(번호 integer primary key, 이름 text, 나이 int)", db)
//   sqlite.run("insert into 손님(이름, 나이) values(?, ?)", db, ["루미", 3])
//   for 줄 in sqlite.rows("select * from 손님 where 나이 > ?", db, [1]):
//       print(줄["이름"], 줄["나이"])
//   sqlite.close(db)
//
// ★ 값은 반드시 ? 자리로 넘기세요 ★
//
//   sqlite.run("... where 이름 = '" + 입력 + "'", db)      // 절대 이렇게 하지 마세요
//   sqlite.run("... where 이름 = ?", db, [입력])            // 이렇게
//
// 앞엣것은 사용자가 이름 칸에 SQL 을 적어 넣으면 그대로 실행됩니다 (SQL 주입).
// 뒤엣것은 값이 SQL 과 따로 가므로 무슨 글자가 들어와도 그냥 값입니다.
//
// --- 어디서 SQLite 를 가져오나 ---
// 운영체제에 이미 있는 것을 빌려 씁니다. 윈도우 10 이상은 winsqlite3.dll,
// 맥은 libsqlite3.dylib 이 기본으로 있고, 리눅스는 대부분 libsqlite3.so 가 있습니다.
// (없으면 배포판 패키지로 깔면 됩니다 — 우분투: apt install libsqlite3-0)
//
// 안쪽은 ccall 로 C 함수를 직접 부릅니다. 그쪽은 서명을 한 글자만 틀려도 프로그램이
// 그냥 죽는 위험한 곳이라, 이 파일이 그것을 다 감싸 두었습니다. 여기 있는 함수만
// 쓰면 잘못 써도 DatabaseError 가 날 뿐 죽지는 않습니다.


// --- 라이브러리 열기 (이 파일을 bring 할 때 한 번) --------------------------

func _find_lib():
    // 이름을 차례로 넣어 봅니다. cload 가 운영체제 관례대로 장식을 붙여 봅니다.
    for name in ["sqlite3", "winsqlite3"]:
        try:
            return cload(name)
        catch FileNotFound e:
            continue
    error("DatabaseError", "SQLite 를 찾지 못했습니다. 윈도우 10 이상·맥에는 기본으로 "
                         + "있고, 리눅스는 libsqlite3 을 깔면 됩니다 "
                         + "(우분투: apt install libsqlite3-0).")

val _lib = _find_lib()

// SQLite 가 쓰는 번호들
val _OK = 0
val _ROW = 100
val _DONE = 101
val _TRANSIENT = -1        // "이 글자를 복사해 두라"는 뜻


// --- 안에서만 쓰는 것들 -----------------------------------------------------

func _handle(db):
    // db 딕셔너리에서 진짜 주소를 꺼냅니다
    if type(db) != "dict" or not has(db, "_p"):
        error("DatabaseError", "이건 sqlite.open 이 준 데이터베이스가 아닙니다")
    if db["_p"] == 0:
        error("DatabaseError", "이미 닫힌 데이터베이스입니다")
    return db["_p"]

func _why(p):
    val m = ccall(_lib, "sqlite3_errmsg", "p>s", [p])
    if m == none:
        return "까닭을 알 수 없습니다"
    return m

// sql 을 준비해서 문(statement) 주소를 돌려줍니다
func _prepare(sql, p, values):
    val slot = cbuf(8)
    val rc = ccall(_lib, "sqlite3_prepare_v2", "psipp>i", [p, sql, -1, slot, 0])
    val st = cget("p", slot)
    cfree(slot)
    if rc != _OK:
        error("DatabaseError", "SQL 을 읽지 못했습니다 (" + str(rc) + "): " + _why(p)
                             + "\n  SQL: " + sql)

    // ? 자리에 값 끼우기 — 자리 번호는 1 부터입니다
    val i = 1
    for v in values:
        val brc = _bind(st, i, v)
        if brc != _OK:
            ccall(_lib, "sqlite3_finalize", "p>i", [st])
            error("DatabaseError", str(i) + "번째 값을 넣지 못했습니다: " + _why(p))
        i = i + 1
    return st

func _bind(st, i, v):
    if v == none:
        return ccall(_lib, "sqlite3_bind_null", "pi>i", [st, i])
    val t = type(v)
    if t == "int":
        return ccall(_lib, "sqlite3_bind_int64", "pil>i", [st, i, v])
    if t == "float":
        // 실수는 마지막 인자라야 넘길 수 있습니다 — 이 서명이 마침 그렇습니다
        return ccall(_lib, "sqlite3_bind_double", "pid>i", [st, i, v])
    if t == "bool":
        val n = 0
        if v:
            n = 1
        return ccall(_lib, "sqlite3_bind_int64", "pil>i", [st, i, n])
    if t == "bytes":
        return ccall(_lib, "sqlite3_bind_blob", "pibip>i", [st, i, v, len(v), _TRANSIENT])
    // 그 밖은 글자로
    return ccall(_lib, "sqlite3_bind_text", "pisip>i", [st, i, str(v), -1, _TRANSIENT])

// 지금 줄을 딕셔너리로 (칸 이름 -> 값)
func _row(st):
    val row = {}
    val ncols = ccall(_lib, "sqlite3_column_count", "p>i", [st])
    for val c = 0, c < ncols, c++:
        val name = ccall(_lib, "sqlite3_column_name", "pi>s", [st, c])
        row[name] = _cell(st, c)
    return row

func _cell(st, c):
    val kind = ccall(_lib, "sqlite3_column_type", "pi>i", [st, c])
    if kind == 5:                                      // NULL
        return none
    if kind == 1:                                      // INTEGER
        return ccall(_lib, "sqlite3_column_int64", "pi>l", [st, c])
    if kind == 2:                                      // FLOAT
        return ccall(_lib, "sqlite3_column_double", "pi>d", [st, c])
    if kind == 4:                                      // BLOB
        val addr = ccall(_lib, "sqlite3_column_blob", "pi>p", [st, c])
        val length = ccall(_lib, "sqlite3_column_bytes", "pi>i", [st, c])
        if addr == 0:
            return encode("")
        return cbytes(length, addr)
    return ccall(_lib, "sqlite3_column_text", "pi>s", [st, c])   // TEXT


// --- 열고 닫기 --------------------------------------------------------------

// 경로에 ":memory:" 를 주면 기억 장치에만 두는 데이터베이스가 됩니다 (시험용).
func open(path):
    val slot = cbuf(8)
    val rc = ccall(_lib, "sqlite3_open", "sp>i", [path, slot])
    val p = cget("p", slot)
    cfree(slot)
    if rc != _OK:
        val why = "열지 못했습니다"
        if p != 0:
            why = _why(p)
            ccall(_lib, "sqlite3_close", "p>i", [p])
        error("DatabaseError", path + " 를 열지 못했습니다 (" + str(rc) + "): " + why)
    return {"_p": p, "path": path}

func close(db):
    if type(db) != "dict" or not has(db, "_p"):
        error("DatabaseError", "이건 sqlite.open 이 준 데이터베이스가 아닙니다")
    if db["_p"] == 0:
        return none                    // 두 번 닫아도 탈 없이
    ccall(_lib, "sqlite3_close", "p>i", [db["_p"]])
    db["_p"] = 0
    return none


// --- 물어보기 ---------------------------------------------------------------

// 줄을 돌려주지 않는 것 (create / insert / update / delete).
// 바뀐 줄 수를 돌려줍니다.
func run(sql, db, values = []):
    val p = _handle(db)
    val st = _prepare(sql, p, values)
    val rc = ccall(_lib, "sqlite3_step", "p>i", [st])
    ccall(_lib, "sqlite3_finalize", "p>i", [st])
    if rc != _DONE and rc != _ROW:
        error("DatabaseError", "돌리지 못했습니다 (" + str(rc) + "): " + _why(p)
                             + "\n  SQL: " + sql)
    return ccall(_lib, "sqlite3_changes", "p>i", [p])

// 줄들을 딕셔너리 리스트로 돌려줍니다.
func rows(sql, db, values = []):
    val p = _handle(db)
    val st = _prepare(sql, p, values)
    val out = []
    val rc = ccall(_lib, "sqlite3_step", "p>i", [st])
    while rc == _ROW:
        push(out, _row(st))
        rc = ccall(_lib, "sqlite3_step", "p>i", [st])
    ccall(_lib, "sqlite3_finalize", "p>i", [st])
    if rc != _DONE:
        error("DatabaseError", "읽지 못했습니다 (" + str(rc) + "): " + _why(p)
                             + "\n  SQL: " + sql)
    return out

// 첫 줄 하나만 (없으면 none)
func one(sql, db, values = []):
    val found = rows(sql, db, values)
    if len(found) == 0:
        return none
    return found[0]

// 첫 줄 첫 칸만 — count(*) 처럼 값 하나를 셀 때 (없으면 none)
func value(sql, db, values = []):
    val row = one(sql, db, values)
    if row == none:
        return none
    val names = keys(row)
    if len(names) == 0:
        return none
    return row[names[0]]

// 방금 넣은 줄의 번호
func lastid(db):
    return ccall(_lib, "sqlite3_last_insert_rowid", "p>l", [_handle(db)])


// --- 한 묶음으로 (트랜잭션) --------------------------------------------------

// 함수를 한 묶음으로 돌립니다. 도중에 오류가 나면 **하나도 안 한 것으로 되돌립니다.**
// 중간에 전원이 나가도 반쯤 된 상태가 남지 않습니다 — 이게 파일에 직접 쓰는 것과
// 데이터베이스의 가장 큰 차이입니다.
//
//   sqlite.tx(func: 옮기기(가, 나, 1000), db)
func tx(fn, db):
    val p = _handle(db)
    run("begin", db)
    try:
        val result = fn()
        run("commit", db)
        return result
    catch e:
        run("rollback", db)
        error(e.type, e.message)


// --- 있나 없나 --------------------------------------------------------------

func hastable(name, db):
    val row = one("select name from sqlite_master where type='table' and name=?", db, [name])
    return row != none

func tables(db):
    val out = []
    for row in rows("select name from sqlite_master where type='table' order by name", db):
        push(out, row["name"])
    return out

// SQLite 판 번호
func version():
    return ccall(_lib, "sqlite3_libversion", ">s", [])
