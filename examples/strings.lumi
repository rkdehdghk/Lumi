// 따옴표 두 가지 (Quotes) in Lumi
//
//   "글자"   큰따옴표 - 이스케이프를 읽습니다 (\n \t \" \\ \r \e 가 ...)
//   '글자'   작은따옴표 - \ 를 있는 그대로 둡니다
//
// 규칙은 한 줄입니다: 작은따옴표 안에서는 \ 가 그냥 \ 입니다.
// 나온 값은 둘 다 똑같은 문자열이라, 따옴표가 하는 일은 여기서 끝납니다.
//
// 적는 규칙: 파일·폴더 주소는 작은따옴표, 사람에게 보여 줄 글자는 큰따옴표.
// 언어가 막아 주지는 않지만 (나온 값이 같으니까요) 지켜 두면 편합니다.

print("=== 이스케이프 (큰따옴표) ===")
print("첫 줄\n둘째 줄")
print("이름\t나이")
print("그가 \"안녕\" 이라 했다")
print("역슬래시 하나: \\")

print("")
print("=== 보이지 않는 글자 ===")
// \r \a \b \f \v \e - 하나같이 글자 하나입니다
print(len("\r"), len("\a"), len("\b"), len("\f"), len("\v"), len("\e"))
val line = "첫 줄\r\n둘째 줄"                  // 윈도우식 줄바꿈을 직접 적을 때
print(len(line))                              // 9     \r \n 도 글자 하나씩
print("색\e[0m 은 \\e 로 시작합니다")         // 터미널 색깔 코드

print("")
print("=== 번호로 글자 적기 ===")
print("\x41\x42\x43")                       // ABC          두 자리
print("\u0041 \uac00 \ud558")         // A 가 하        네 자리
print("\U0001f600" == "\U0001F600")         // true         여덟 자리, 대소문자 상관없음
print(len("\U0001f600"))                    // 1            번호 하나가 글자 하나
print("\uc548\ub155" == "안녕")          // true
// 자릿수를 채워야 합니다: "\uac0" 은 오류
// 번호는 1 부터 10ffff 까지입니다: "\x00" 은 오류

print("")
print("=== 있는 그대로 (작은따옴표) ===")
print('C:\notes\temp.txt')                  // 적은 그대로
print('a\nb', len('a\nb'))                  // a\nb 4      글자 네 개
print('그가 "안녕" 이라 했다')                // 큰따옴표를 그냥 넣을 수 있습니다

print("")
print("=== 나온 값은 구별이 없습니다 ===")
print('abc' == "abc")                       // true
print(type('a'), type('abc'))               // char str
print(upper('abc'), split('/', 'a/b/c'))    // ABC ["a", "b", "c"]
print('안녕 ' + "루미")                      // 안녕 루미     서로 이을 수 있습니다

print("")
print("=== 어느 쪽을 쓸까 ===")
// 줄바꿈·탭이 필요하면 큰따옴표
val tabbed = "이름\t점수\n루미\t100"
print(tabbed)
// 주소는 언제나 작은따옴표 (탐색기에서 복사해 그대로 붙여넣기)
val winpath = 'C:\Windows\notepad.exe'
print(winpath)                                  // C:\Windows\notepad.exe  \ 가 그대로 살아 있습니다
// (그 파일이 정말 있는지는 여기서 묻지 않습니다 — 윈도우에만 있는 파일이라
//  리눅스·맥에서는 답이 달라져 시험이 기계마다 갈립니다)
print(isfile('note.txt'))                   // false    이름만 적은 것도 주소입니다
// 안에 " 를 넣고 싶으면 작은따옴표, ' 를 넣고 싶으면 큰따옴표
print('말 안에 "따옴표"', "don't")

print("")
print("=== 못 하는 것 ===")
// 작은따옴표 안에는 ' 를 넣을 수 없습니다 (이스케이프가 없으니까요).
// 'don't' 는 오류입니다 -> 큰따옴표로 "don't" 라고 쓰세요.
print("don't")
