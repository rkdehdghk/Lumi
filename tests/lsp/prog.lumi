bring math up sqrt

val limit = 10

func area(width, height):
    return width * height

func report(width):
    val total = area(width, limit)
    return total + sqrt(width)

class Box:
    func init(size):
        this.size = size

print(area(2, 3), report(4), Box(1).size)
