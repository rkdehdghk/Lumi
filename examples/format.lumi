// Format (서식 맞추기) in Lumi
//
// 다른 문자열 함수들처럼 '채울 값' 들을 앞에, 서식 문자열을 마지막에 적습니다.
//   format(값1, 값2, ..., 서식문자열)      ->  위치 순서대로 {} 에 채움
//   format(리스트_또는_튜플, 서식문자열)    ->  리스트/튜플 원소를 순서대로 {} 에 채움
//   format(딕셔너리, 서식문자열)           ->  키 이름 {key} 에 맞춰 채움

print("=== 위치 순서대로 채우기 ({}) ===")
print(format("홍길동", 20, "이름: {}, 나이: {}"))          // 이름: 홍길동, 나이: 20
print(format(1, 2, 3, "합: {} + {} = {}"))                // 합: 1 + 2 = 3

print("")
print("=== 번호 지정해서 채우기 ({0}, {1}) ===")
print(format("세계", "안녕", "{1}, {0}!"))                 // 안녕, 세계!
print(format("사과", "{0}는 맛있어요. {0} 좋아!"))           // 사과는 맛있어요. 사과 좋아!

print("")
print("=== 리스트나 튜플을 묶어서 넘기기 ===")
val 품목 = ["사과", 3, 1500]
print(format(품목, "품목: {}, 개수: {}개, 가격: {}원"))      // 품목: 사과, 개수: 3개, 가격: 1500원

val 점수목록 = (90, 85, 100)
print(format(점수목록, "국어: {0}, 영어: {1}, 수학: {2}"))     // 국어: 90, 영어: 85, 수학: 100

print("")
print("=== 딕셔너리로 이름 맞춰 채우기 ({key}) ===")
val 사용자 = {"name": "Alex", "score": 95}
print(format(사용자, "User {name} scored {score} points")) // User Alex scored 95 points

print("")
print("=== 서식 지정자 (소수점, 진법, 정렬, 0채우기) ===")
print(format(3.141592, "원주율: {:.2f}"))                 // 원주율: 3.14
print(format(7, "ID: {:04d}"))                           // ID: 0007
print(format(255, 255, "16진수: {:x}, 2진수: {:b}"))             // 16진수: ff, 2진수: 11111111
print(format("Lumi", "오른쪽 정렬: {:>10}"))               // 오른쪽 정렬:       Lumi
print(format("Lumi", "가운데 정렬: {:^10}"))               // 가운데 정렬:    Lumi

print("")
print("=== 중괄호 그대로 쓰기 ({{ }}) ===")
print(format(42, "값: {} (중괄호 표현: {{}})"))            // 값: 42 (중괄호 표현: {})
