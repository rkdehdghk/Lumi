// 언어 명세(docs/Lumi_Language_Spec.md)에서 **기계가 검사할 수 있는 것**을 검사합니다.
//
// 이 파일이 있는 까닭: 명세는 산문이라 조용히 낡습니다. 몇 달 뒤에 문서가 거짓말을
// 하고 있지 않도록, 문서에 표로 적어 둔 것만이라도 실제로 그런지 여기서 확인합니다.
// 명세를 고치면 이 파일도 같이 고쳐야 합니다.

// ------------------------------------------------------------------
// 명세 2.4 — 예약어 37 개는 변수 이름으로 쓸 수 없다
// ------------------------------------------------------------------

val 예약어 = [
    "val", "if", "elif", "else", "while", "func", "return",
    "true", "false", "none", "and", "or", "not", "print",
    "bring", "up", "for", "in", "break", "continue",
    "global", "local", "switch", "case", "default",
    "class", "from", "this", "super", "use", "abstract",
    "try", "catch", "safe", "always", "error", "test"
]

test "명세 2.4: 예약어는 37 개다":
    assertsame(37, len(예약어))

test "명세 2.4: 예약어는 변수 이름이 될 수 없다":
    for 낱말 in 예약어:
        val 막혔나 = false
        try:
            eval("val " + 낱말 + " = 1")
        catch e:
            막혔나 = true
        assert(막혔나, "'" + 낱말 + "' 이(가) 변수 이름으로 통과했습니다 - 예약어 목록과 렉서가 어긋납니다")

test "명세 2.4: 자료형 이름은 예약어가 아니다":
    // 뒤에 이름이 오면 선언, 아니면 형 변환 — 그래서 예약어가 아닙니다
    for 낱말 in ["int", "float", "num", "char", "str", "text", "seq", "bytes"]:
        assertsame(false, 낱말 in 예약어)
    assertsame(5, int("5"))
    int 자리 = 5
    assertsame(5, 자리)


// ------------------------------------------------------------------
// 명세 4.2 — 연산자 우선순위 표
// ------------------------------------------------------------------

test "명세 4.2: ** 는 앞에 붙는 - 보다 높다":
    // 표에서 놀라기 쉬운 자리 1
    assertsame(-4, -2 ** 2)
    assertsame(4, (-2) ** 2)

test "명세 4.2: ** 는 오른쪽부터 묶인다":
    assertsame(512, 2 ** 3 ** 2)          // 2^(3^2) 이지 (2^3)^2 = 64 가 아닙니다

test "명세 4.2: 비트 연산은 비교보다 높다 (C 와 다름)":
    // C 라면 a & b == c 가 a & (b == c) 라서 괄호를 꼭 쳐야 합니다.
    // Lumi 는 (a & b) == c 로, 사람이 기대하는 대로 묶입니다.
    assertsame((1 & 2) == 2, 1 & 2 == 2)
    assertsame(false, 1 & 2 == 2)           // 1 & 2 = 0, 0 == 2 -> false
    assertsame((1 | 2) < 4, 1 | 2 < 4)
    assertsame((6 >> 1) == 3, 6 >> 1 == 3)

test "명세 4.2: 곱하기가 더하기보다 높다":
    assertsame(7, 1 + 2 * 3)
    assertsame(9, (1 + 2) * 3)

test "명세 4.2: 비교가 and/or 보다 높다":
    assertsame(true, 1 < 2 and 3 < 4)
    assertsame(true, 1 > 2 or 3 < 4)

test "명세 4.2: and 가 or 보다 높다":
    // true or (false and false) = true.  (true or false) and false = false 였을 것
    assertsame(true, true or false and false)

test "명세 4.2: 같은 단계는 왼쪽부터 묶인다":
    assertsame(4, 10 - 5 - 1)             // (10-5)-1 이지 10-(5-1)=6 이 아닙니다
    assertsame(2, 16 / 4 / 2)

test "명세 4.2: 뒤에 붙는 것들이 가장 높다":
    val 목록 = [[1, 2], [3, 4]]
    assertsame(3, 목록[1][0])
    assertsame(false, not 목록[0][0] == 1 and false)


// ------------------------------------------------------------------
// 명세 5.5 — 딕셔너리 키 동일성: 값과 갈래가 둘 다 같아야 같은 키
// ------------------------------------------------------------------

test "명세 5.5: 1 과 true 는 다른 키다":
    val d = {1: "정수", true: "참"}
    assertsame(2, len(d))
    assertsame("정수", d[1])
    assertsame("참", d[true])

test "명세 5.5: 그래도 1 == true 는 참이다":
    // 값으로 견주는 것과 키로 쓰는 것은 다른 규칙입니다
    assertsame(true, 1 == true)

test "명세 5.5: 1 과 1.0 은 같은 키다":
    val d = {}
    d[1] = "먼저"
    d[1.0] = "나중"
    assertsame(1, len(d))


// ------------------------------------------------------------------
// 명세 5.6 — 숫자
// ------------------------------------------------------------------

test "명세 5.6: 정수 넘침은 조용히 감기지 않는다":
    val 최대 = 9223372036854775807
    val 났나 = false
    try:
        val 넘김 = 최대 + 1
    catch MathError e:
        났나 = true
    assert(났나, "정수 넘침이 그냥 지나갔습니다")

test "명세 5.6: 0 으로 나누면 MathError":
    val 났나 = false
    try:
        val x = 1 / 0
    catch MathError e:
        났나 = true
    assert(났나)

test "명세 5.6: 나누어떨어지지 않으면 실수가 된다":
    assertsame(2.5, 5 / 2)
    assertsame(2, 4 / 2)


// ------------------------------------------------------------------
// 명세 5.7 — 자리 세기와 자르기
// ------------------------------------------------------------------

test "명세 5.7: 자리는 0 부터, 음수는 뒤에서부터":
    val xs = [10, 20, 30]
    assertsame(10, xs[0])
    assertsame(30, xs[-1])
    assertsame(20, xs[-2])

test "명세 5.7: 자르기는 범위를 넘어도 오류가 아니다":
    val xs = [1, 2, 3]
    assertsame([1, 2, 3], xs[0:99])
    assertsame([], xs[5:9])

test "명세 5.7: 하나 꺼내기는 범위를 넘으면 IndexError":
    val 났나 = false
    try:
        val x = [1, 2, 3][99]
    catch IndexError e:
        났나 = true
    assert(났나)

test "명세 5.7: 없는 키는 KeyError":
    val 났나 = false
    try:
        val x = {"a": 1}["b"]
    catch KeyError e:
        났나 = true
    assert(났나)

test "명세 5.7: 글자는 바이트가 아니라 글자로 센다":
    assertsame(2, len("한글"))
    assertsame("나", "가나다"[1])


// ------------------------------------------------------------------
// 명세 5.10 — 오류 종류의 갈래 (부모로 잡으면 자식도 잡힌다)
// ------------------------------------------------------------------

// [자식, 부모] 짝.  명세 5.10 의 나무를 그대로 옮긴 것입니다.
val 갈래 = [
    ["IndexError", "LookupError"],
    ["KeyError", "LookupError"],
    ["LookupError", "Error"],
    ["FileNotFound", "FileError"],
    ["FileError", "Error"],
    ["TypeError", "Error"],
    ["ValueError", "Error"],
    ["NameError", "Error"],
    ["MathError", "Error"],
    ["ArgumentError", "Error"],
    ["NetworkError", "Error"],
    ["DatabaseError", "Error"],
    ["AssertError", "Error"]
]

test "명세 5.10: 부모로 잡으면 자식도 잡힌다":
    for 짝 in 갈래:
        val 자식 = 짝[0]
        val 부모 = 짝[1]
        val 잡혔나 = false
        try:
            error(자식, "시험")
        catch e:
            // 여기 오기 전에 부모로 잡히는지 따로 확인합니다 (아래 eval 로)
            잡혔나 = true
        assert(잡혔나, 자식 + " 을 아무도 못 잡았습니다")

test "명세 5.10: IndexError 는 LookupError 로 잡힌다":
    val 잡혔나 = false
    try:
        val x = [1][5]
    catch LookupError e:
        잡혔나 = true
    assert(잡혔나)

test "명세 5.10: KeyError 도 LookupError 로 잡힌다":
    val 잡혔나 = false
    try:
        val x = {"a": 1}["없음"]
    catch LookupError e:
        잡혔나 = true
    assert(잡혔나)

test "명세 5.10: 무엇이든 Error 로 잡힌다":
    for 짝 in 갈래:
        val 잡혔나 = false
        try:
            error(짝[0], "시험")
        catch Error e:
            잡혔나 = true
        assert(잡혔나, 짝[0] + " 이(가) Error 로 안 잡혔습니다")

test "명세 5.10: 내가 지은 종류도 Error 로 잡힌다":
    val 잡혔나 = false
    try:
        error("내가지은것", "시험")
    catch Error e:
        잡혔나 = true
        assertsame("내가지은것", e.type)
    assert(잡혔나)

test "명세 5.10: 안 맞는 종류는 그 catch 가 안 잡는다":
    val 어디서 = ""
    try:
        error("ValueError", "시험")
    catch TypeError e:
        어디서 = "TypeError"
    catch ValueError e:
        어디서 = "ValueError"
    assertsame("ValueError", 어디서)

test "명세 5.10: 오류 값은 type 과 message 를 갖는다":
    try:
        error("ValueError", "설명글")
    catch e:
        assertsame("ValueError", e.type)
        assertsame("설명글", e.message)


// ------------------------------------------------------------------
// 명세 5.2 — 내장 함수가 내 함수보다 먼저 잡힌다
// ------------------------------------------------------------------
// 이 언어에서 가장 조용히 틀리는 자리입니다.  lumi lint 의 첫 번째 규칙이
// 이것을 경고하는데, 경고할 값어치가 있는지는 이 시험이 지켜 줍니다.

func len(무엇):
    return "내 것"

class 상자:
    func len():
        return "메서드는 멀쩡"

test "명세 5.2: 내장이 먼저라 내 함수는 안 불린다":
    assertsame(3, len([1, 2, 3]))         // 내 len 이 아니라 내장 len

test "명세 5.2: 메서드는 이 규칙을 안 탄다":
    val b = 상자()
    assertsame("메서드는 멀쩡", b.len())


// ------------------------------------------------------------------
// 명세 5.4 — 참과 거짓
// ------------------------------------------------------------------

test "명세 5.4: 비어 있는 것은 거짓이다":
    for 것 in [0, 0.0, "", [], {}, false, none]:
        assertsame(false, bool(것))

test "명세 5.4: 그 밖은 참이다":
    for 것 in [1, -1, 0.5, "a", [0], {"a": 1}, true]:
        assertsame(true, bool(것))


// ------------------------------------------------------------------
// 명세 5.8 — 기본값은 부를 때마다 새로 셈한다
// ------------------------------------------------------------------

func 쌓기(것, 통 = []):
    push(통, 것)
    return 통

test "명세 5.8: 기본값이 값을 물고 있지 않다":
    // 파이썬이라면 두 번째가 [1, 2] 가 됩니다.  Lumi 는 부를 때마다 새로 만듭니다.
    assertsame([1], 쌓기(1))
    assertsame([2], 쌓기(2))

test "명세 5.8: 이름 붙인 인자는 자리를 건너뛴다":
    func f(a, b = 2, c = 3):
        return [a, b, c]
    assertsame([1, 2, 3], f(1))
    assertsame([1, 9, 3], f(1, b = 9))
    assertsame([1, 2, 9], f(1, c = 9))

test "명세 5.8: 자리가 모자라면 ArgumentError":
    func f(a, b):
        return a + b
    val 났나 = false
    try:
        f(1)
    catch ArgumentError e:
        났나 = true
    assert(났나)


// ------------------------------------------------------------------
// 명세 5.3 — 변수와 유효 범위
// ------------------------------------------------------------------

test "명세 5.3: 없는 것을 고치려 하면 NameError":
    val 났나 = false
    try:
        eval("이런이름은없습니다 = 1")
    catch e:
        났나 = true
    assert(났나)

test "명세 5.3: if 는 새 환경을 만들지 않는다":
    // 들여쓴다고 다 새 환경이 되는 것이 아닙니다 (명세 5.3 의 표)
    if true:
        val 안쪽 = 1
    assertsame(1, 안쪽)

test "명세 5.3: for 는 한 바퀴마다 새 환경을 만든다":
    for i in [1, 2]:
        val 한바퀴 = i
    val 났나 = false
    try:
        eval("print(한바퀴)")
    catch e:
        났나 = true
    assert(났나, "for 몸통의 val 이 밖으로 새어 나왔습니다")

test "명세 5.3: for 안에서 만든 함수는 각자 그 바퀴 값을 붙든다":
    // 한 바퀴마다 새 환경인 진짜 까닭입니다
    val 함수들 = []
    for i in [1, 2, 3]:
        val 지금 = i
        push(함수들, func x: 지금)
    assertsame([1, 2, 3], [f(0) for f in 함수들])
