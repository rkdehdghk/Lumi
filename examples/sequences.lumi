// 시퀀스 : 리스트·튜플·문자열(그리고 바이트)은 한 가족입니다.
// 넷 다 이것들을 똑같이 할 수 있습니다 — 자리 꺼내기, 자르기, len(), for-in, +, *, in
// (바이트는 따로 예제가 있습니다: bytes.lumi)

// --- seq 자료형은 어떤 시퀀스든 담습니다 ---
seq a = [1, 2, 3]        // 리스트
seq b = "hello"          // 문자열
seq c = (10, 20, 30)     // 튜플

print("values:", a, b, c)
print("types :", type(a), type(b), type(c))   // list  str  tuple  (담은 모양 그대로)

// --- 셋 모두에 똑같이 쓰는 연산들 ---
print("first  :", a[0], b[0], c[0])            // 1 h 10
print("last   :", a[-1], b[-1], c[-1])         // 3 o 30
print("slice  :", a[1:], b[1:4], c[:2])        // [2, 3]  ell  (10, 20)
print("length :", len(a), len(b), len(c))      // 3 5 3
print("joined :", a + [4], b + "!", c + (40,)) // [1,2,3,4]  hello!  (10,20,30,40)

// --- 되풀이 : 시퀀스 * 횟수 (자기 자신을 그만큼 이어 붙입니다) ---
print("repeat :", a * 2, b * 3, c * 2)         // [1,2,3,1,2,3]  hellohellohello  (10,20,30,10,20,30)
print("line   :", "-" * 20)                    // 줄 20칸짜리 구분선
seq board = [0] * 9                            // 0이 아홉 개인 리스트 만들기
print("board  :", board)                       // [0, 0, 0, 0, 0, 0, 0, 0, 0]

// seq 로 선언한 변수에는 다른 종류의 시퀀스를 다시 담아도 됩니다
a = "was a list, now a string"
print("a =", a)

// 값을 안 주고 선언하면 빈 리스트로 시작합니다
seq box
print("empty box:", box, "len", len(box))      // [] len 0

// --- 들었는지 묻기 : in / not in ---
print("e in hello   :", "e" in b)              // true
print("ell in hello :", "ell" in b)            // true   문자열은 '이어진 조각'도 찾습니다
print("20 in c      :", 20 in c)               // true
print("7 not in a   :", 7 not in [1, 2, 3])    // true

// in 으로 단어 속 모음 개수 세기
val vowels = "aeiou"
val n = 0
for ch in "sequence":
    if ch in vowels:
        n += 1
print("vowels in 'sequence':", n)              // 4
