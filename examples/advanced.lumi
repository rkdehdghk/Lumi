// 조금 더 나아간 기능들 — 거듭제곱 **, 비트연산, 튜플, 지역/전역 변수

// --- ** 거듭제곱 (오른쪽부터 묶입니다) ---
print("--- power (**) ---")
print(2 ** 10)        // 1024
print(9 ** 0.5)       // 3      제곱근도 거듭제곱으로
print(2 ** -1)        // 0.5    음수 지수는 역수
print(2 ** 3 ** 2)    // 512    2 ** (3 ** 2) 로 묶입니다

// --- 비트연산 (정수끼리만 됩니다) ---
print("--- bitwise ---")
print(6 & 3)          // 2      둘 다 1인 자리만 1 (AND)
print(6 | 1)          // 7      하나라도 1이면 1 (OR)
print(6 ^ 3)          // 5      서로 다르면 1 (XOR)
print(~5)             // -6     모든 자리 뒤집기 (NOT)
print(1 << 4)         // 16     왼쪽으로 4칸 밀기 (x2를 4번)
print(255 >> 4)       // 15     오른쪽으로 4칸 밀기

// --- 튜플 : 못 바꾸는 리스트, 소괄호 ( ) 로 만듭니다 ---
print("--- tuples ---")
val point = (3, 4)
print(point)          // (3, 4)
print(point[0], point[-1])   // 3 4
print(len(point))     // 2
print(point[1:])      // (4,)   원소 하나짜리 튜플은 쉼표를 남깁니다
print((1, 2) + (3, 4))       // (1, 2, 3, 4)
print(type(point))    // tuple
for v in (10, 20, 30):
    print(v)
// point[0] = 9       // <- 오류: 튜플은 한 번 만들면 못 바꿉니다

// --- 지역변수와 전역변수 ---
print("--- local / global ---")
val score = 1

func play():
    local score = 100          // 이 함수 안에서만 사는 변수 (바깥 score 는 그대로)
    print("in play, score =", score)   // 100
    global winner = "Kim"      // 함수 안에서 전역변수 만들기

play()
print("outside, score =", score)   // 1     바깥 score 는 안 바뀌었습니다
print("winner =", winner)          // Kim   전역이라 밖에서도 보입니다
