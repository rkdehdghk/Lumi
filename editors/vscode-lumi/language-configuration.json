{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/.", "./"]
  },
  "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "/.", "close": " ./" }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["{", "}"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": ":\\s*$",
    "decreaseIndentPattern": "^\\s*(else|elif|catch|safe|always|default|case)\\b"
  }
}
