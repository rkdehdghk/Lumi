// Shuffle (뒤섞기) in Lumi
//
// sort 가 순서대로 줄을 세우는 것이라면, shuffle 은 그 반대로
// 순서를 무작위로 흩어 놓습니다.
//   shuffle(시퀀스)  ->  원소들의 순서를 무작위로 바꾼 새 시퀀스
//
// 나온 것은 넣은 것과 같은 종류이고, 원래 값은 그대로 남습니다.
// 부를 때마다 결과가 달라지므로, 아래 주석의 결과는 '예시 하나'입니다.

print("=== 무작위로 섞기 ===")
print(shuffle([1, 2, 3, 4, 5]))     // [3, 5, 1, 4, 2]   부를 때마다 달라집니다
print(shuffle([1, 2, 3, 4, 5]))     // [2, 1, 5, 3, 4]
print(shuffle("abcdef"))            // "dbfaec"          글자도 섞입니다

print("")
print("=== 넣은 것과 같은 종류가 나옵니다 ===")
print(type(shuffle([1, 2, 3])))     // list
print(type(shuffle((1, 2, 3))))     // tuple
print(type(shuffle("abc")))         // str
print(type(shuffle(encode("abc")))) // bytes

print("")
print("=== 원본은 그대로입니다 ===")
val xs = [1, 2, 3]
print(shuffle(xs))    // 섞인 '새 리스트'
print(xs)             // [1, 2, 3]   원본은 그대로!
xs = shuffle(xs)      // 남기려면 이렇게 다시 넣습니다
print(len(xs))        // 3           개수는 언제나 그대로

print("")
print("=== 섞어도 들어 있는 값은 그대로 ===")
// 자리만 바뀌므로, 다시 줄을 세우면 처음과 똑같아집니다
print(sort(shuffle([3, 1, 2])) == [1, 2, 3])   // true
print(len(shuffle("hello")) == len("hello"))   // true

print("")
print("=== 견줄 필요가 없으니 아무 값이나 섞입니다 ===")
// sort 와 달리 크고 작음을 따지지 않으므로 갈래가 섞여 있어도 됩니다
print(shuffle([1, "가", true, [2]]))           // 값 종류가 섞여도 OK
print(shuffle([]))                             // []   빈 것도 그대로
print(shuffle([7]))                            // [7]  하나뿐이면 그대로
// print(shuffle({"a": 1}))                    // Error: 딕셔너리는 keys/values 로

print("")
print("=== 자주 쓰는 모양 ===")
// 1) 아무거나 하나 고르기
val 메뉴 = ["김밥", "라면", "돈까스", "비빔밥"]
print("오늘 점심:", shuffle(메뉴)[0])

// 2) 여러 개 뽑기 (섞고 앞에서 자르기)
print("추천 2개:", shuffle(메뉴)[0:2])

// 3) 순서 정하기 (제비뽑기)
val 이름들 = ["가영", "나연", "다은", "라희"]
val 차례 = shuffle(이름들)
for i in forr(val n = 0, n < len(차례), n = n + 1):
    print(i + 1, "번째:", 차례[i])

// 4) 카드 섞기
print("")
val 카드 = []
for 무늬 in ["S", "H", "D", "C"]:
    for 숫자 in ["A", "2", "3"]:
        push(카드, 무늬 + 숫자)
print("카드", len(카드), "장 중 5장:", shuffle(카드)[0:5])

// 5) 문제 순서 섞기
val 문제 = [["2+2는?", 4], ["3*3은?", 9], ["10-1은?", 9]]
for 한문제 in shuffle(문제):
    print(한문제[0], "정답:", 한문제[1])
