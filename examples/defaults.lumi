// 기본값 인자와 이름 붙인 인자 (Default & Named Arguments)
//
//   func f(a, b = 2):       b 를 안 주면 2 로 칩니다
//   f(1, b = 9)             인자에 이름을 붙여 줄 수 있습니다
//
// 옵션이 여럿인 함수를 만들 때, 함수를 여러 개로 쪼개지 않아도 됩니다.

print("=== 1. 기본값 ===")
func greet(name, word = "안녕", bang = false):
    val s = word + ", " + name
    if bang:
        return s + "!"
    return s

print(greet("루미"))                    // 안녕, 루미
print(greet("루미", "반가워"))           // 반가워, 루미
print(greet("루미", "반가워", true))     // 반가워, 루미!
print("")


print("=== 2. 이름을 붙여 주기 ===")
// 가운데 것을 건너뛰고 뒤엣것만 주고 싶을 때 씁니다.
print(greet("루미", bang = true))      // 안녕, 루미!
// 이름을 붙이면 순서를 바꿔도 됩니다.
print(greet(word = "하이", name = "영희"))
print("")


print("=== 3. 기본값 있는 것은 뒤에 ===")
// func g(a = 1, b): 는 오류입니다.
// 기본값이 붙은 매개변수는 반드시 뒤쪽에 모아 둡니다.
// 마찬가지로 부를 때도 이름 붙인 것을 뒤에 둡니다: f(1, b = 2)  (O)
//                                                f(a = 1, 2)   (X)
print("규칙: 기본값도, 이름 붙인 인자도 '뒤에'")
print("")


print("=== 4. 기본값은 부를 때마다 새로 셈합니다 ===")
// 파이썬에서 자주 걸리는 함정(기본값 리스트를 함수가 계속 나눠 쓰는 것)이
// Lumi 에는 없습니다. 부를 때마다 [] 를 새로 만듭니다.
func collect(item, bucket = []):
    push(bucket, item)
    return bucket

print(collect(1))       // [1]
print(collect(2))       // [2]   <- [1, 2] 가 아닙니다
print("")

// 기본값 안에서 바깥 변수도 쓸 수 있습니다.
val DEFAULT_UNIT = "개"
func count(n, unit = DEFAULT_UNIT):
    return str(n) + unit
print(count(3))
print(count(3, "명"))
print("")


print("=== 5. 클래스에서도 똑같이 ===")
class Box:
    func init(name, weight = 1.0):
        this.name = name
        this.weight = weight

    func grow(factor = 2):
        this.weight = this.weight * factor
        return this.weight

    func text():
        return this.name + "(" + str(this.weight) + ")"

val apple = Box("사과")
print("만들 때 생략 :", apple)
print("메서드 생략  :", apple.grow())
print("이름 붙이기  :", apple.grow(factor = 10))

val pear = Box(name = "배", weight = 3.0)
print("만들 때 이름 :", pear)
print("")


print("=== 6. 실무에서 쓰는 모양 ===")
// 옵션이 많은 함수를 하나로 둘 수 있습니다.
func draw_table(rows, sep = " | ", header = true, limit = 0):
    val shown = rows
    if limit > 0:
        shown = rows[0:limit]
    val out = []
    for val i = 0, i < len(shown), i++:
        val line = join(sep, shown[i])
        if i == 0 and header:
            push(out, line)
            push(out, "-" * len(line))
        else:
            push(out, line)
    return join("\n", out)

val data = [["이름", "부서"], ["김철수", "영업"], ["이영희", "개발"]]
print(draw_table(data))
print("")
print(draw_table(data, sep = ", ", header = false))
print("")
print(draw_table(data, limit = 2))
