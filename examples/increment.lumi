// 증감 연산자 (++ / --) 예제
// i++ 는 i = i + 1, i-- 는 i = i - 1 과 똑같습니다.
// 앞에 붙이든(++i) 뒤에 붙이든(i++) 뜻은 같습니다.

val i = 5
i++                 // 6
print(i)
i--                 // 5
print(i)
++i                 // 6 (앞에 붙여도 똑같음)
print(i)

// 리스트/딕셔너리 원소에도 됩니다
val nums = [10, 20, 30]
nums[0]++
nums[2]--
print(nums)         // [11, 20, 29]

// C 스타일 for 의 증감식에 딱 좋습니다
for val k = 0, k < 5, k++:
    print("k =", k)
