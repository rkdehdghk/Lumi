// 웹으로 주고받기 (bring http)
//
//   http.get(주소)                 -> 답 딕셔너리
//   http.post(본문, 주소)           -> 답 딕셔너리   (write(내용, 파일) 과 같은 차례)
//   http.getjson(주소)             -> 답에 "자료" 가 풀려서 함께 옵니다
//   http.download(주소, 파일이름)    -> 받은 바이트 수
//   http.serve(포트, 처리함수)       -> 작은 웹 서버 열기
//
// 이 예제는 **인터넷이 없어도** 끝까지 돕니다 — 바깥에 나가는 부분은
// try 로 감싸 두었습니다.

bring http

print("=== 1. 답이 어떻게 생겼나 ===")
print("답 = { \"ok\": true, \"코드\": 200, \"본문\": \"...\", \"머리말\": {...} }")
print("")
print("규칙 두 가지:")
print("  * 404 나 500 은 오류가 아닙니다 — 서버가 제대로 답한 것이라 \"코드\"로 옵니다.")
print("    ok 는 코드가 200~299 일 때만 true 입니다.")
print("  * 주소를 못 찾거나 연결이 끊기면 NetworkError 를 냅니다. try 로 잡으세요.")
print("")


print("=== 2. 가져오기 ===")
try:
    val 답 = http.get("https://example.com")
    print("ok    :", 답["ok"])
    print("코드  :", 답["코드"])
    print("길이  :", len(답["본문"]))
    print("종류  :", 답["머리말"]["content-type"])
    print("제목  :", findmatch("<title>[^<]*</title>", 답["본문"]))
catch NetworkError e:
    print("(인터넷이 없어 건너뜁니다)")
print("")


print("=== 3. 없는 길은 오류가 아니라 404 ===")
try:
    val 답 = http.get("https://example.com/이런길은없어요")
    print("ok:", 답["ok"], "/ 코드:", 답["코드"], "  <- 던지지 않고 돌려줍니다")
catch NetworkError e:
    print("(인터넷 없음)")
print("")


print("=== 4. 못 닿으면 NetworkError ===")
try:
    http.get("https://이런도메인은절대없습니다.invalid/")
    print("!! 여기 오면 안 됩니다")
catch NetworkError e:
    print("제대로 잡음:", e.type)
print("")


print("=== 5. 보내기 ===")
print("http.post(본문, 주소)                      글자 그대로 보내기")
print("http.postjson({\"이름\": \"루미\"}, 주소)      JSON 으로 보내고 받기")
print("http.put / http.delete                    같은 모양")
print("")
print("머리말을 붙이려면 세 번째에 딕셔너리를 줍니다:")
print("  http.get(주소, {\"Authorization\": \"Bearer ...\"})")
print("")


print("=== 6. 작은 웹 서버 ===")
// 처리 함수는 요청 딕셔너리를 받아 답 딕셔너리를 돌려줍니다.
func 처리(요청):
    // 요청 = {"방법":"GET", "길":"/인사", "물음":{"이름":"루미"}, "머리말":{...}, "본문":"..."}
    if 요청["길"] == "/인사":
        val 이름 = "누구세요"
        if has(요청["물음"], "이름"):
            이름 = 요청["물음"]["이름"]
        return {"코드": 200, "본문": "안녕 " + 이름}
    return {"코드": 404, "본문": "그런 길은 없습니다"}

print("이렇게 적고:")
print("  http.serve(8080, 처리)        멈출 때까지 계속 (Ctrl+C 로 끕니다)")
print("  http.serve(8080, 처리, 1)     딱 한 번만 받고 돌아오기 (시험할 때)")
print("")
print("그러면 브라우저에서 http://localhost:8080/인사?이름=루미 로 볼 수 있습니다.")
print("")
print("알아 둘 것:")
print("  * 길은 %EC%95%88 같은 적기를 풀어서 줍니다 (한글 주소가 그대로 옵니다).")
print("  * 물음표 뒤는 이름=값 짝을 갈라 딕셔너리로 줍니다.")
print("  * 한 번에 손님 하나씩 받습니다 — 사내 도구·웹훅 받기·만들어 보기용입니다.")
print("  * 처리 함수가 터져도 서버는 죽지 않습니다. 500 을 보내고 다음 손님을 받습니다.")
print("  * https 는 서버 쪽에서 지원하지 않습니다 (앞에 nginx 같은 것을 두세요).")
print("")


print("=== 7. 어떻게 만들어졌나 ===")
print("클라이언트는 curl 을 불러서 씁니다 (윈도우 10·맥·대부분 리눅스에 기본 탑재).")
print("바깥 라이브러리를 끌어오지 않으려는 선택입니다 — libraries/http.lumi 를 열어")
print("보면 전부 Lumi 로 적혀 있어서 고쳐 쓸 수 있습니다.")
print("서버는 운영체제 소켓만 써서 인터프리터 안에 직접 들어 있습니다.")
