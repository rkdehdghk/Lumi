// Case conversion & whitespace removal (대소문자·공백) in Lumi
//
// 세 함수 모두 '어디를' 손볼지 먼저, '문자열'을 마지막에 적습니다.
//   upper([어디,] 문자열)  ->  대문자로 바꾼 새 문자열
//   lower([어디,] 문자열)  ->  소문자로 바꾼 새 문자열
//   strip([어디,] 문자열)  ->  공백을 지운 새 문자열
//
// '어디를' 은 네 가지로 적을 수 있습니다.
//   안 적음        전체
//   자리 번호      그 한 글자만        (0부터 셉니다. 음수면 뒤에서부터)
//   시작:끝        그 구간만          (슬라이싱과 같은 방식)
//   [자리, 자리]   적어 준 자리들만    (튜플도 됩니다)

print("=== 전체 바꾸기 (어디를 안 적으면 전부) ===")
val 말 = "hello world"
print(말)
print(upper(말))                  // HELLO WORLD
print(lower("LUMI Language"))     // lumi language

print("")
print("=== 한 글자만 바꾸기 ===")
print(upper(0, 말))               // Hello world
print(upper(6, 말))               // hello World
print(upper(-1, 말))              // hello worlD   음수는 뒤에서부터
print(lower(0, "HELLO"))          // hELLO

print("")
print("=== 구간으로 바꾸기 (슬라이싱과 같은 방식) ===")
print(upper(0:5, 말))             // HELLO world   0 이상 5 미만
print(upper(:5, 말))              // HELLO world   시작 생략 = 처음부터
print(upper(6:, 말))              // hello WORLD   끝 생략 = 마지막까지
print(upper(:, 말))               // HELLO WORLD   둘 다 생략 = 전체
print(upper(3:3, 말))             // hello world   빈 구간이라 그대로

// 시작과 끝에 변수나 식을 넣어도 됩니다.
val 시작 = 2
val 끝 = 5
print(upper(시작:끝, 말))          // heLLO world
print(upper(시작:len(말), 말))     // heLLO WORLD

print("")
print("=== 자리 리스트로 바꾸기 (떨어져 있는 자리들) ===")
print(upper([0, 6], 말))          // Hello World
print(upper([0, 2, 4], "abcdef")) // AbCdEf
print(upper((0, 1), "abc"))       // ABc           튜플도 됩니다
print(upper([], "abc"))           // abc           빈 리스트면 그대로

print("")
print("=== 원래 문자열은 그대로 있어요 ===")
// 바뀐 '새 문자열'을 돌려주기 때문에, 남기려면 다시 넣어 줍니다.
print(말)                         // hello world   그대로
val 큰말 = upper(말)
print(큰말)                       // HELLO WORLD

print("")
print("=== 대소문자가 없는 글자는 그대로 지나가요 ===")
print(upper("lumi 2026!"))        // LUMI 2026!
print(upper("루미 lumi"))          // 루미 LUMI

print("")
print("=== 이름처럼 첫 글자만 대문자로 ===")
func 이름꼴(이름):
    return upper(0, lower(이름))

print(이름꼴("hONG"))              // Hong
print(이름꼴("lumi"))              // Lumi

print("")
print("=== 찾은 자리만 바꾸기 (infind 와 함께) ===")
// infind 가 돌려준 자리 리스트를 그대로 넘기면 찾은 곳만 바뀝니다.
print(infind("o", 말))            // [4, 7]
print(upper(infind("o", 말), 말))  // hellO wOrld

print("")
print("=== 단어마다 첫 글자를 대문자로 ===")
val 첫자리 = [0]
for 자리 in infind(" ", 말):
    push(첫자리, 자리 + 1)
print(첫자리)                      // [0, 6]
print(upper(첫자리, 말))           // Hello World

print("")
print("=== 검사하고 나서 바꾸기 ===")
val 아이디 = "Lumi2026"
if isalgit(아이디):
    print("쓸 수 있는 아이디:", lower(아이디))   // lumi2026
else:
    print("영어와 숫자만 적어 주세요")

print("")
print("=== 공백 지우기 (strip) - 적는 법은 위와 똑같아요 ===")
// 자리:  0=a  1=공백  2=b  3=공백  4=c  5=공백  6=d
val 띄어 = "a b c d"
print(띄어)
print(strip(띄어))                 // abcd      전체의 공백
print(strip("  안녕   하세요  "))   // 안녕하세요

print("")
print("=== 자리 / 구간 / 리스트로 골라 지우기 ===")
print(strip(1, 띄어))              // ab c d    1번 자리가 공백이라 지워짐
print(strip(0, 띄어))              // a b c d   0번은 'a' 라서 그대로 (글자는 안 지워요)
print(strip(0:3, 띄어))            // ab c d    0~2 사이의 공백만
print(strip(3:, 띄어))             // a bcd     3번부터 끝까지
print(strip(:, 띄어))              // abcd      전체와 같음
print(strip([1, 5], 띄어))         // ab cd     적어 준 자리들만
print(strip([], 띄어))             // a b c d   빈 리스트면 그대로

print("")
print("=== 자리 번호는 '지우기 전' 문자열 기준이에요 ===")
// 앞의 공백을 지워서 길이가 줄어도, 뒤에 적은 번호가 밀리지 않습니다.
print(strip([1, 3, 5], 띄어))      // abcd
print(띄어)                        // a b c d   원본은 그대로

print("")
print("=== 탭과 줄바꿈도 공백이에요 ===")
print(strip("탭\t줄\n끝"))          // 탭줄끝

print("")
print("=== 입력에 섞인 공백 털어내기 ===")
val 답 = " 42 "                    // input() 으로 받았다고 생각해 보세요
print(num(strip(답)) + 1)          // 43

print("")
print("=== 앞뒤만 털고 가운데 띄어쓰기는 남기기 ===")
val 글 = "  안녕 하세요  "
print(strip(0:2, strip(-2:, 글)))  // 안녕 하세요

print("")
print("=== 공백 자리를 찾아서 하나만 지우기 ===")
print(infind(" ", 띄어))                 // [1, 3, 5]
print(strip(infind(" ", 띄어)[0], 띄어))  // ab c d   맨 앞 공백 하나만

print("")
print("=== 셋을 함께 쓰기 ===")
val 이름 = "  hong GIL dong  "
print(upper(0, lower(strip(이름))))      // Honggildong
