// 일부러 CRLF 로 저장한 파일입니다 - 지우거나 줄 끝을 바꾸지 마세요.
//
// 렉서가 빈 줄을 줄바꿈 글자 하나로만 알아보던 시절, CRLF 파일에서는 블록 안의
// 빈 줄이 칸 수 0 으로 읽혀 블록을 통째로 닫아 버렸습니다. 그래서 윈도우에서 적은
// .lumi 가 통째로 안 열렸습니다 (libraries/sqlite.lumi 가 실제로 그렇게 깨졌습니다).

func 더하기(a, b):
    val 합 = a + b

    // 위의 빈 줄이 이 시험의 전부입니다
    return 합

class 상자:
    func init(값):
        this.값 = 값

    func 꺼내기():

        return this.값

print(더하기(3, 4))
print(상자(9).꺼내기())
