// 문법 설탕 - 없어도 되지만 있으면 짧아지는 두 가지
//   ?.  앞의 것이 none 이면 none (안전한 꺼내기)
//   ??  none 일 때만 오른쪽 (기본값)

class 사람:
    func init(이름, 윗사람):
        this.이름 = 이름
        this.윗사람 = 윗사람
    func 인사():
        return "안녕, " + this.이름

print("=== 1. ?. 안전하게 꺼내기 ===")

val 사장 = 사람("한사장", none)
val 대리 = 사람("김대리", 사장)

print(대리.이름)              // 김대리
print(대리?.윗사람?.이름)     // 한사장
print(사장?.윗사람?.이름)     // none  (사장에겐 윗사람이 없습니다)

// . 하나였다면 여기서 오류가 났을 것입니다.
// ?. 는 마디마다 붙입니다 - 사장?.윗사람.이름 은 none.이름 이라 오류입니다.

print("")
print("=== 2. ?. 로 부르기 ===")

print(대리?.인사())           // 안녕, 김대리
val 아무도없음 = none
print(아무도없음?.인사())     // none  (부르지 않습니다)

print("")
print("=== 3. ?? 기본값 ===")

val 설정 = {"이름": "루미", "칸": none}

print(설정["이름"] ?? "이름없음")     // 루미
print(설정["칸"] ?? 4)               // 4

// or 와 다릅니다: or 는 0 과 "" 과 false 도 거짓으로 보고 갈아치웁니다.
print(0 or 99)                       // 99
print(0 ?? 99)                       // 0
print("" or "빈칸")                  // 빈칸
print("" ?? "빈칸")                  // (빈 줄)

print("")
print("=== 4. 둘을 같이 ===")

func 윗사람이름(누구):
    return 누구?.윗사람?.이름 ?? "없음"

print(윗사람이름(대리))       // 한사장
print(윗사람이름(사장))       // 없음
print(윗사람이름(none))       // 없음
