// 서버 쪽 — tests\run.bat 이 client.lumi 와 짝지어 돌립니다.
// (tests/lang 이 아니라 여기 있는 까닭: lumi test 가 집어가면 기다리다 멈춥니다)
bring http

func 처리(요청):
    if 요청["path"] == "/인사":
        val 이름 = "없음"
        if has(요청["query"], "이름"):
            이름 = 요청["query"]["이름"]
        return {"code": 200, "body": "안녕 " + 이름,
                "headers": {"Content-Type": "text/plain; charset=utf-8"}}
    if 요청["path"] == "/메아리":
        return {"code": 200, "body": 요청["method"] + "|" + 요청["body"]}
    if 요청["path"] == "/터져":
        val xs = [1]
        return xs[99]
    return {"code": 404, "body": "없는 길"}

http.serve(18077, 처리, 4)
