// 손님 쪽 — server.lumi 가 먼저 떠 있어야 합니다.
bring http

val 실패 = 0
func 확인(설명, 기대, 나온것):
    if 기대 == 나온것:
        print("  ok   " + 설명)
    else:
        실패 = 실패 + 1
        print("  FAIL " + 설명 + " : 기대 " + str(기대) + " 인데 " + str(나온것))

val a = http.get("http://127.0.0.1:18077/인사?이름=루미")
확인("한글 길과 물음 딕셔너리", "안녕 루미", a["본문"])
확인("성공은 ok=true", true, a["ok"])
확인("보낸 머리말이 돌아옴", true, has(a["머리말"], "content-type"))

val b = http.get("http://127.0.0.1:18077/없는길")
확인("404 는 오류가 아님", 404, b["코드"])
확인("404 는 ok=false", false, b["ok"])

val c = http.post("보낸 본문", "http://127.0.0.1:18077/메아리")
확인("POST 방법과 본문", "POST|보낸 본문", c["본문"])

val d = http.get("http://127.0.0.1:18077/터져")
확인("처리가 터지면 500", 500, d["코드"])

if 실패 == 0:
    print("  http 서버: 모두 통과")
else:
    print("  http 서버: 실패 " + str(실패) + " 건")
