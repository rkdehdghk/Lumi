// Text Evaluation (글자 식 실행) in Lumi
//
// eval(문자열) 은 글자로 적어 둔 '식' 을 그 자리에서 계산해서
// 값으로 돌려줍니다.
//   eval("1 + 2 * 3")  ->  7
//
// 코드를 값처럼 들고 다니다가, 필요할 때 실행할 수 있습니다.

print("=== 글자로 적은 식 계산하기 ===")
print(eval("1 + 2 * 3"))            // 7
print(eval("2 ** 10"))              // 1024
print(eval("[1, 2, 3][1:]"))        // [2, 3]
print(eval("upper(\"abc\")"))       // ABC

print("")
print("=== 부른 자리의 변수를 그대로 씁니다 ===")
val x = 10
print(eval("x ** 2"))               // 100
print(eval("x + len(\"hello\")"))   // 15

func twice(n):
    return n * 2

print(eval("twice(21)"))            // 42      내가 만든 함수도 부릅니다

print("")
print("=== 함수 안의 지역 변수도 보입니다 ===")
func 숨겨보기():
    val 숨은값 = 7
    return eval("숨은값 * 3")

print(숨겨보기())                    // 21

print("")
print("=== 식을 만들어서 실행하기 ===")
val 코드 = "x" + " + " + "5"
print(코드)                          // x + 5
print(eval(코드))                    // 15

// 여러 식을 리스트에 담아 두었다가 하나씩 계산합니다
val 식들 = ["1 + 1", "3 * 3", "len([1,2,3])", "sort([3,1,2])"]
for 식 in 식들:
    print(식, "=", eval(식))
// 1 + 1 = 2
// 3 * 3 = 9
// len([1,2,3]) = 3
// sort([3,1,2]) = [1, 2, 3]

print("")
print("=== eval 안에서 다시 eval ===")
print(eval("eval(\"2 + 2\")"))      // 4

print("")
print("=== 값이 되는 '식' 하나만 됩니다 ===")
// 아래것들은 모두 오류라서 주석으로만 적어 둡니다.
//   eval("x = 1")   대입은 문장이라 값이 아닙니다
//   eval("")        식이 하나 있어야 합니다
//   eval(5)         글자(문자열)를 넣어야 합니다
// eval 안에서 난 오류의 줄 번호는 그 문자열 안에서 센 번호(보통 1)입니다.
print("식만 됩니다. 문장(x = 1)은 오류입니다.")
