// 리스트와 반복문 (Lists and for-loops)

// --- 리스트 만들기 ---
val nums = [10, 20, 30]
print("nums =", nums)

// 자리 번호로 꺼내기 (0부터 셉니다. 음수는 뒤에서부터)
print("first:", nums[0])
print("last:", nums[-1])
print("length:", len(nums))

// + 로 두 리스트를 이어 붙이면 새 리스트가 나옵니다
print("joined:", [1, 2] + [3, 4])

// --- for-in : 리스트의 값을 하나씩 꺼내기 ---
print("--- for-in over a list ---")
for x in [100, 200, 300]:
    print(x)

// --- for-in : 문자열은 글자 하나씩 꺼냅니다 ---
print("--- for-in over a string ---")
for ch in "Hi!":
    print(ch)

// --- C 스타일 for : for 초기화, 조건, 증감: (쉼표로 구분, 괄호·세미콜론 없음) ---
print("--- C-style for ---")
for val i = 0, i < 5, i = i + 1:
    print(i)

// C 스타일 for 로 1부터 10까지 더하기
val total = 0
for val k = 1, k <= 10, k = k + 1:
    total = total + k
print("sum 1..10 =", total)

// --- push 로 뒤에 넣고, pop 으로 뒤에서 빼기 (원본을 직접 고칩니다) ---
val stack = []
push(stack, "a")
push(stack, "b")
push(stack, "c")
print("stack =", stack)
print("popped:", pop(stack))
print("stack now =", stack)

// --- 리스트 안의 리스트 (대괄호를 이어 붙여 파고듭니다) ---
val grid = [[1, 2], [3, 4]]
print("grid[1][0] =", grid[1][0])

// --- forr() : 정수 범위를 리스트로 만들어 줍니다 (파이썬의 range) ---
print("--- forr() ---")
print(forr(val i = 0, i < 5, i = i + 1))     // [0, 1, 2, 3, 4]
print(forr(val i = 3, i > 0, i = i - 1))     // [3, 2, 1]

// forr() 은 for-in 과 짝지어 쓰면 편합니다
for n in forr(val k = 1, k <= 3, k = k + 1):
    print("n =", n)

// --- break : 반복문을 즉시 빠져나오기 ---
print("--- break ---")
for x in [1, 2, 3, 4, 5]:
    if x == 4:
        break
    print("x =", x)

// --- continue : 이번 차례만 건너뛰기 ---
print("--- continue ---")
for x in [1, 2, 3, 4, 5]:
    if x == 3:
        continue
    print("x =", x)        // 1, 2, 4, 5  (3 is skipped)

// --- 자리 번호로 값 바꾸기 ---
print("--- index assignment ---")
val scores = [10, 20, 30]
scores[0] = 99
scores[-1] = 77
print("scores =", scores)          // [99, 20, 77]

// 리스트 안의 리스트도 자리를 짚어 바꿀 수 있습니다
val grid = [[1, 2], [3, 4]]
grid[1][0] = 88
print("grid =", grid)              // [[1, 2], [88, 4]]
