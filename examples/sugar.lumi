// 문법 설탕 - 없어도 되지만 있으면 짧아지는 두 가지
//   ?.  앞의 것이 none 이면 none (안전한 꺼내기)
//   ??  none 일 때만 오른쪽 (기본값)

class Person:
    func init(name, manager):
        this.name = name
        this.manager = manager
    func greet():
        return "안녕, " + this.name

print("=== 1. ?. 안전하게 꺼내기 ===")

val ceo = Person("한사장", none)
val junior = Person("김대리", ceo)

print(junior.name)              // 김대리
print(junior?.manager?.name)     // 한사장
print(ceo?.manager?.name)     // none  (사장에겐 윗사람이 없습니다)

// . 하나였다면 여기서 오류가 났을 것입니다.
// ?. 는 마디마다 붙입니다 - ceo?.manager.name 은 none.name 이라 오류입니다.

print("")
print("=== 2. ?. 로 부르기 ===")

print(junior?.greet())           // 안녕, 김대리
val nobody = none
print(nobody?.greet())     // none  (부르지 않습니다)

print("")
print("=== 3. ?? 기본값 ===")

val config = {"이름": "루미", "칸": none}

print(config["이름"] ?? "이름없음")     // 루미
print(config["칸"] ?? 4)               // 4

// or 와 다릅니다: or 는 0 과 "" 과 false 도 거짓으로 보고 갈아치웁니다.
print(0 or 99)                       // 99
print(0 ?? 99)                       // 0
print("" or "빈칸")                  // 빈칸
print("" ?? "빈칸")                  // (빈 줄)

print("")
print("=== 4. 둘을 같이 ===")

func manager_name(who):
    return who?.manager?.name ?? "없음"

print(manager_name(junior))       // 한사장
print(manager_name(ceo))       // 없음
print(manager_name(none))       // 없음
