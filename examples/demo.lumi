// Lumi 언어 둘러보기 — 변수·연산·조건문·반복문·함수를 한 번에 봅니다.
// 세미콜론(;)이 없고, 파이썬처럼 '들여쓰기'로 블록을 만듭니다.

// --- 변수와 사칙연산 ---
val a = 10
val b = 3
print("a + b =", a + b)
print("a / b =", a / b)      // 나누기는 결과가 실수가 될 수 있습니다
print("a % b =", a % b)      // 나머지

// --- if / else : 조건에 따라 갈라지기 ---
if a > b:
    print("a is greater than b")
else:
    print("a is not greater than b")

// --- while 반복문 : 1부터 5까지 더하기 ---
// (내장 함수 sum 과 헷갈리지 않게 변수 이름은 total 로 씁니다)
val total = 0
val i = 1
while i <= 5:
    total = total + i
    i = i + 1
print("sum of 1..5 =", total)

// --- 함수 : 팩토리얼 (자기 자신을 다시 부르는 재귀) ---
func factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)
print("5! =", factorial(5))

// --- if / elif / else : 갈래가 셋 이상일 때 ---
val score = 85
if score >= 90:
    print("Grade: A")
elif score >= 80:
    print("Grade: B")
else:
    print("Grade: C")
