// Text Files (텍스트 파일) in Lumi
//
//   read([인코딩,] 파일이름)          파일을 통째로 읽어 글자로
//   write([인코딩,] 내용, 파일이름)   새로 쓰기 (있던 내용은 지워집니다)
//   append([인코딩,] 내용, 파일이름)  뒤에 이어 쓰기
//   isfile(파일이름)                 그런 파일이 있는지
//   newfile(파일이름)                빈 파일 만들기 (있으면 그대로 둠)
//   delfile(파일이름)                파일 지우기
//   renamefile(새 이름, 파일이름)     파일 이름 바꾸기
//   movefile(폴더, 파일이름)          파일을 그 폴더로 옮기기
//
// 열어 두고 쓰려면 (큰 파일을 한 줄씩 · 여러 번 나눠 쓰기):
//   open([인코딩,] [read/write/append,] 파일이름)   열기
//   readline(파일)          한 줄 읽기 (줄바꿈은 떼고)
//   writeline(내용, 파일)   한 줄 쓰기 (줄바꿈을 붙여서)
//   isend(파일) · read(파일) · write(내용, 파일) · close(파일)
//
// 다른 함수들과 같은 규칙입니다: '어떻게'(인코딩)가 앞, 다룰 파일이 마지막.
//
// 적는 규칙: 주소는 작은따옴표 '...', 사람에게 보여 줄 글자는 큰따옴표 "..." 입니다.
// 이 예제는 자기 폴더(examples/)에 파일을 만들었다가 맨 끝에서 다시 지웁니다.

print("=== 쓰고 읽기 ===")
val nchars = write("첫 줄\n둘째 줄\n", 'note.txt')
print("쓴 글자 수:", nchars)                 // 9
print(read('note.txt'))                      // 첫 줄 / 둘째 줄

print("")
print("=== 이어 쓰기 ===")
append("셋째 줄\n", 'note.txt')
print(read('note.txt'))                      // 세 줄이 모두 나옵니다

print("")
print("=== 파일이 있는지 ===")
print(isfile('note.txt'))                    // true
print(isfile('없는파일.txt'))                 // false

print("")
print("=== 다른 폴더의 파일 (이름 자리에 경로 적기) ===")
// 이름만 적으면 이 .lumi 가 있는 폴더가 기준입니다. 경로를 적으면 다른 폴더도 됩니다.
print(isfile('../README.md'))                // true    .. 는 한 폴더 위
print(isfile('../libraries/math.lumi'))      // true    위로 갔다 옆 폴더로
print(read('../examples/note.txt') == read('note.txt'))   // true  돌아서 온 같은 파일
// 통째로 적은 경로도 그대로 씁니다. 주소는 작은따옴표라서 \ 를 손댈 것이 없습니다:
print('C:\Windows\notepad.exe')              // 그대로   ' ' 안에서는 \ 가 그냥 \
// (있는지까지 묻지는 않습니다 — 윈도우에만 있는 파일이라 리눅스·맥에서
//  답이 달라지고, 그러면 골든 파일이 기계마다 갈립니다)
// 큰따옴표로 적었다면 \n 이 줄바꿈이 되어 오류로 알려 줍니다 (strings.lumi 참고).

print("")
print("=== 줄로 나누어 다루기 ===")
// 파일을 읽으면 그냥 글자라서, 여느 문자열처럼 다루면 됩니다.
val lines = split("\n", read('note.txt'))
erase(len(lines) - 1, lines)                    // 맨 끝 줄바꿈이 남긴 빈 칸 지우기
print("줄 수:", len(lines))                    // 3
for line in lines:
    print("-", line)

print("")
print("=== 표를 파일로 (join 과 짝) ===")
val names = ["보리", "초코", "루미"]
write(join("\n", names), '이름표.txt')
print(read('이름표.txt'))

print("")
print("=== 인코딩 골라 쓰기 ===")
// 안 적으면 언제나 "utf-8" 입니다. 옛 윈도우 프로그램이 만든 파일은 cp949 인 경우가 많아요.
// 인코딩은 주소가 아니라 '어떻게' 이므로 큰따옴표로 적습니다.
write("cp949", "한글 파일\n", 'note.txt')
print(read("cp949", 'note.txt'))             // 한글 파일
// print(read('note.txt'))                   // 오류: utf-8 로는 읽을 수 없는 바이트

print("")
print("=== 만들기 (newfile) ===")
val logname = '기록.txt'
print(newfile(logname))                         // true    빈 파일을 새로 만들었습니다
append("첫 기록\n", logname)
print(newfile(logname))                         // false   이미 있어서 그대로 둡니다
append("한 줄 더\n", logname)
print(read(logname), keep(""))                  // 두 줄 다 살아 있습니다
// newfile 은 있는 파일을 건드리지 않습니다.
// write("", 기록) 은 반대로 내용을 지워 버리니 조심하세요.

print("")
print("=== 폴더 만들기 및 지우기 (newdir · deldir) ===")
val workdir = '연습폴더'
print(newdir(workdir))                      // true    새 폴더를 만들었습니다
print(newdir(workdir))                      // false   이미 있어서 그대로 둡니다
newfile(workdir + '/안속.txt')
print(deldir(workdir))                      // true    속에 파일이 있어도 깔끔히 지웁니다

print("")
print("=== 열어 두고 한 줄씩 쓰기 (open · writeline · close) ===")
// 여는 방법(read / write / append)은 따옴표 없이 적습니다. 안 적으면 읽기입니다.
val diary = open(write, '일기.txt')
print(type(diary))                            // file
print(writeline("월요일: 비", diary))          // 7   붙인 줄바꿈까지 셉니다
writeline("화요일: 맑음", diary)
writeline("수요일: 눈", diary)
print(close(diary))                           // true
print(close(diary))                           // false   이미 닫혔습니다

print("")
print("=== 한 줄씩 읽기 (readline · isend) ===")
val reader = open('일기.txt')
while not isend(reader):
    print("-", readline(reader))               // 줄바꿈이 빠진 '그 줄의 내용'
close(reader)

print("")
print("=== 한 줄 읽어 한 줄 쓰기 (둘은 정확히 반대) ===")
val src = open('일기.txt')
val dst = open(write, '일기복사.txt')
while not isend(src):
    writeline(readline(src), dst)
close(src)
close(dst)
print(read('일기복사.txt') == read('일기.txt'))   // true   그대로 옮겨졌습니다
delfile('일기복사.txt')

print("")
print("=== 한 줄만 읽고, 나머지는 통째로 ===")
val partial = open(read, '일기.txt')
print("첫 줄만:", readline(partial))
print("남은 것:")
print(read(partial), keep(""))                  // 열어 둔 파일에는 read(파일)
print("끝인가?", isend(partial))                 // true
close(partial)

print("")
print("=== 이어 쓰기로 열기 (append) ===")
val appender = open(append, '일기.txt')
writeline("목요일: 흐림", appender)
close(appender)
print("줄 수:", len(split("\n", read('일기.txt'))) - 1)   // 4
delfile('일기.txt')

print("")
print("=== 이름 바꾸기 (renamefile) ===")
write("이름표 연습\n", '옛이름.txt')
print(renamefile('새이름.txt', '옛이름.txt'))   // true    새 이름이 앞입니다
print(isfile('옛이름.txt'), isfile('새이름.txt'))  // false true
print(read('새이름.txt'))                       // 내용은 그대로
delfile('새이름.txt')

print("")
print("=== 다른 폴더로 옮기기 (movefile) ===")
write("옮겨 다니는 파일\n", '짐.txt')
print(movefile('..', '짐.txt'))              // true    폴더가 앞입니다
print(isfile('짐.txt'), isfile('../짐.txt'))  // false true   이름은 그대로입니다
print(read('../짐.txt'))                     // 내용도 그대로
print(movefile('.', '../짐.txt'))            // true    다시 데려옵니다
delfile('짐.txt')

print("")
print("=== 지우기 (delfile) ===")
print(delfile(logname))                         // true
print(isfile(logname))                          // false
// 없는 파일을 지우면 오류입니다. 모를 때는 먼저 물어봅니다:
if isfile(logname):
    delfile(logname)
print("지운 파일은 휴지통에 가지 않습니다.")

// 이 예제가 만든 나머지도 치웁니다
delfile('note.txt')
delfile('이름표.txt')
print("치우고 나니 남은 것:", isfile('note.txt'), isfile('이름표.txt'))
