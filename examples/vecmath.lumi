// 벡터 산술 (Vector Math) in Lumi
//
// 원소별 계산 내장 함수 7가지:  add  sub  mul  div  mod  pow  neg
//
// +, -, * 는 리스트끼리 쓰면 '이어 붙이기·되풀이'가 됩니다.
// 리스트 속 숫자를 '자리마다 짝지어' 계산하고 싶을 때 이 가족을 씁니다.
//   숫자   와 숫자   -> 그냥 계산
//   시퀀스 와 숫자   -> 모든 원소에 그 숫자를 적용
//   시퀀스 와 시퀀스 -> 같은 자리끼리 (짧은 쪽 길이에 맞춥니다)

// --- 1. add(a, b) : 더하기 ---
print("1. add(3, 5):", add(3, 5))                              // 8
print("2. add([1, 2, 3], 10):", add([1, 2, 3], 10))            // [11, 12, 13]
print("3. add([1, 2], [10, 20]):", add([1, 2], [10, 20]))      // [11, 22]

// --- 2. sub(a, b) : 빼기 ---
print("4. sub([10, 20, 30], 5):", sub([10, 20, 30], 5))        // [5, 15, 25]
print("5. sub([10, 20], [1, 2]):", sub([10, 20], [1, 2]))      // [9, 18]

// --- 3. mul(a, b) : 곱하기 ---
print("6. mul([1, 2, 3], 2):", mul([1, 2, 3], 2))              // [2, 4, 6]
print("7. mul([2, 3], [4, 5]):", mul([2, 3], [4, 5]))          // [8, 15]

// --- 4. div(a, b) : 나누기 (결과는 언제나 실수, 0으로 나누면 오류) ---
print("8. div([10, 20, 30], 10):", div([10, 20, 30], 10))      // [1, 2, 3]
print("9. div([10, 20], [2, 5]):", div([10, 20], [2, 5]))      // [5, 4]

// --- 5. mod(a, b) : 나머지 ---
print("10. mod([10, 11, 12], 3):", mod([10, 11, 12], 3))       // [1, 2, 0]

// --- 6. pow(a, b) : 거듭제곱 ---
print("11. pow([2, 3, 4], 2):", pow([2, 3, 4], 2))             // [4, 9, 16]

// --- 7. neg(a) : 부호 뒤집기 (혼자 쓰는 하나짜리) ---
print("12. neg([1, -2, 3]):", neg([1, -2, 3]))                 // [-1, 2, -3]

// --- 겹쳐 쓰기 : 점수에 가중치를 곱하고 보너스를 더하기 ---
val scores = [80, 90, 70]
val weights = [1.1, 1.0, 1.2]
print("가중 점수:", add(mul(scores, weights), 5))

print("\n모든 벡터 산술 내장 함수 테스트 성공!")
